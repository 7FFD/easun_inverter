#!/bin/sh /etc/rc.common
# procd init script for easun-bridge. Settings live in /etc/easun-bridge.conf

START=95
STOP=10
USE_PROCD=1

start_service() {
	# shellcheck disable=SC1091
	. /etc/easun-bridge.conf
	procd_open_instance
	procd_set_param command /usr/bin/easun-bridge \
		-inverter-ip "$INVERTER_IP" -local-ip "$LOCAL_IP" \
		-mqtt "$MQTT_BROKER" -mqtt-user "${MQTT_USER:-}" -mqtt-pass "${MQTT_PASS:-}" \
		-model "${MODEL:-}" -device-id "${DEVICE_ID:-easun_inverter}" \
		-bms-capacity-wh "${BMS_CAPACITY_WH:-0}" \
		-topic "${TOPIC:-easun/inverter}" -regs "${REGS:-}" -interval "${INTERVAL:-20s}"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
